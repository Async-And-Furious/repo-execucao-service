DATABASE_URL="postgresql://postgres:postgres@localhost:5434/execucao_producao?connection_limit=3"
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS=
JWT_ALGORITHM="HS256"
JWT_SECRET="change-me-local-only"
JWT_PUBLIC_KEY=""
JWT_ISSUER="repo-auth-serverless"
JWT_AUDIENCE="async-furious-project"
JWT_EXPIRES_IN="1800"
KAFKA_BROKERS="localhost:9092"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""
KAFKA_CONSUMER_GROUP="execucao-service"

# Exportar NEW_RELIC_* antes de iniciar o processo; ConfigModule carrega .env tarde demais.
NEW_RELIC_ENABLED="false"
NEW_RELIC_NO_CONFIG_FILE="true"
NEW_RELIC_APP_NAME="af-execucao-local"
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED="true"
NEW_RELIC_APPLICATION_LOGGING_ENABLED="true"
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED="true"
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED="false"
NEW_RELIC_LOG="stdout"
